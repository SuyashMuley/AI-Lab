# llm-cli reads LLMCLI_* environment variables (and a .env in the working directory).
# Precedence: CLI flags > env vars > ./.llmcli.toml > ~/.config/llmcli/config.toml > defaults.
# Secrets (API keys) are env-only and can never be stored in config files.

LLMCLI_PROVIDER=ollama
LLMCLI_MODEL=llama3.2
# LLMCLI_OLLAMA_HOST=http://localhost:11434
# LLMCLI_TIMEOUT=60            # seconds of provider silence before failing
# LLMCLI_MAX_RETRIES=2         # retries on 429 / 5xx / connection errors
# LLMCLI_SCHEMA_RETRIES=2      # retries when output fails --schema validation
# LLMCLI_SAVE_HISTORY=true     # set false to stop saving conversations
# LLMCLI_API_KEY=              # for remote providers (env only)

# Locations (defaults shown)
# LLMCLI_CONFIG_HOME=~/.config/llmcli
# LLMCLI_DATA_HOME=~/.local/share/llmcli
